# Browser sends to this same-origin proxy route (prevents CORS)
NEXT_PUBLIC_AURORA_SEND_PROXY_PATH=/api/openclaw/send
# Aurora responses API text location
NEXT_PUBLIC_AURORA_REPLY_TEXT_PATH=items.0.content.0.text
# Shared dashboard session id (example from dashboard URL)
NEXT_PUBLIC_AURORA_SHARED_SESSION_ID=agent:main:main

# Server-side Aurora transport settings used by /api/openclaw/send
AURORA_SEND_BASE_URL=http://127.0.0.1:18789
AURORA_SEND_AUTH_TOKEN=your_token_here
AURORA_SEND_AGENT_ID=main
AURORA_SEND_MODEL=openclaw
# Optional stable user id for Aurora session continuity
AURORA_SEND_USER=aurora-wrapper-local
# Shared session/thread identifier target
AURORA_SESSION_ID=agent:main:main
# Comma-separated payload fields that should receive AURORA_SESSION_ID
AURORA_SESSION_FIELDS=user
AURORA_SEND_METHOD=POST
AURORA_SEND_PATH=/v1/responses
AURORA_SEND_HEADERS={}
AURORA_SEND_TEXT_FIELD=input
AURORA_SEND_STREAM=true
AURORA_SEND_MAX_OUTPUT_TOKENS=4096
# Optional additional top-level payload fields, JSON object string
AURORA_SEND_EXTRA_BODY={}

# Discord bot bridge (requires the Aurora wrapper server to be running)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
# Absolute URL for Aurora's existing send proxy route
AURORA_DISCORD_PROXY_URL=http://127.0.0.1:3000/api/openclaw/send
# Session namespace for Discord conversations
AURORA_DISCORD_SESSION_PREFIX=agent:main:discord
# Persistence file for Discord previous_response_id/session linkage
AURORA_DISCORD_STATE_PATH=.aurora/discord-session-state.json
# dms_and_mentions | mentions_only | all_messages
AURORA_DISCORD_REPLY_MODE=dms_and_mentions
# Optional allowlists for guild traffic
AURORA_DISCORD_ALLOWED_GUILD_IDS=
AURORA_DISCORD_ALLOWED_CHANNEL_IDS=
# Optional: route this user's DMs through owner continuity instead of a Discord-specific session
AURORA_DISCORD_OWNER_USER_ID=

# Read-only local state endpoint (never triggers model inference)
NEXT_PUBLIC_AURORA_STATE_PATH=/api/aurora/state
# Poll interval for read-only state refresh (5-10 seconds recommended)
NEXT_PUBLIC_AURORA_STATE_POLL_MS=7000
NEXT_PUBLIC_CHAT_HISTORY_LIMIT=12
NEXT_PUBLIC_AURORA_TTS_ENABLED=true
NEXT_PUBLIC_AURORA_TTS_STREAM_PATH=/api/aurora/tts/stream
NEXT_PUBLIC_AURORA_TTS_VOICE=alloy

# Server-side path for read-only continuity file
AURORA_CONTEXT_PATH=/Users/cadem/Documents/New project/.aurora/aurora-context.json

# Persistent autobiographical memory graph + runtime state (server-side)
AURORA_MEMORY_PATH=.aurora/autobiographical-memory.json
# Append-only event log used by memory/reflection/introspection modules
AURORA_EVENT_LOG_PATH=.aurora/autobiographical-events.ndjson
# Compliance log proving each generation used preflight memory/attention/introspection
AURORA_COMPLIANCE_LOG_PATH=.aurora/compliance.ndjson
# Continuous cognitive loop interval (milliseconds, range 1000-10000)
AURORA_LOOP_INTERVAL_MS=2000

# Voice/presence synthesis (Alloy by default)
OPENAI_API_KEY=your_openai_key_here
OPENAI_TTS_MODEL=gpt-4o-mini-tts
AURORA_TTS_ENABLED=true
AURORA_TTS_VOICE=alloy
# Optional style instruction hints for TTS model
AURORA_TTS_INCLUDE_INSTRUCTIONS=false

# Optional server-side chat proxy for the native Auri iPhone app.
# The app itself should not embed secrets; point it at /api/auri/chat instead.
# Auri is pinned to the OpenAI API with GPT-5.4 Nano.
AURI_CHAT_API_KEY=your_openai_key_here
AURI_CHAT_MODEL=gpt-5.4-nano

# Selective multimodal camera reinspection stays off unless both client and server opt in.
NEXT_PUBLIC_AURORA_VISION_REMOTE_ANALYSIS_ENABLED=false
AURORA_VISION_REMOTE_ANALYSIS_ENABLED=false
# Keep this on Aurora's real runtime analysis model by default.
AURORA_VISION_REMOTE_ANALYSIS_MODEL=aurora
# low by default; the client may escalate to high on uncertain or safety-focused frames.
NEXT_PUBLIC_AURORA_VISION_REMOTE_ANALYSIS_DETAIL=low
AURORA_VISION_REMOTE_ANALYSIS_DETAIL=low
# Skip remote analysis whenever the local heuristics mark screen/document/ID sensitive regions.
AURORA_VISION_REMOTE_ANALYSIS_REQUIRE_NO_SENSITIVE_REGIONS=true
# Upstream timeout in milliseconds for the selective vision analysis call.
AURORA_VISION_REMOTE_ANALYSIS_TIMEOUT_MS=9000
# Isolated semantic session for vision analysis so it shares runtime path without polluting owner chat continuity.
AURORA_VISION_REMOTE_ANALYSIS_SESSION_ID=agent:main:vision:analysis

# Remote Codex companion auth token. Set this before exposing the Next app beyond your home network.
CODEX_COMPANION_TOKEN=replace_with_a_long_random_secret
# Workspace the phone companion should target when it dispatches Codex work.
CODEX_COMPANION_WORKSPACE_CWD=/Users/cadem/Documents/New project
# workspace-write is safer; switch to danger-full-access only if you really want parity with your desktop session.
CODEX_COMPANION_SANDBOX=workspace-write
# Optional model override for phone-dispatched Codex work.
CODEX_COMPANION_MODEL=gpt-5.4
# Native iPhone companion API target. Use your Tailscale hostname here if you want the app to keep working away from home.
CODEX_COMPANION_NATIVE_API_BASE_URL=http://cades-mac-mini.tail1afb62.ts.net:3000
# Optional fallback for deriving the API base URL, or for temporarily running the live-server shell mode over Tailscale.
CODEX_COMPANION_NATIVE_SERVER_URL=http://cades-mac-mini.tail1afb62.ts.net:3000/codex-companion
# Set to 1 if you want the iPhone wrapper to open the remote web page directly so web changes show up without reinstalling the app.
CODEX_COMPANION_NATIVE_USE_LIVE_SERVER=0
# Optional native wrapper identifiers.
CODEX_COMPANION_NATIVE_APP_ID=com.cade.dexco
CODEX_COMPANION_NATIVE_APP_NAME=Codey
# Legacy Aurora-prefixed companion variables still work as fallbacks.
